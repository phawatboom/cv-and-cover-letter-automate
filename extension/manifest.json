{
  "manifest_version": 3,
  "name": "Cover Letter Copilot",
  "version": "0.7.1",
  "description": "Fills in the repetitive parts of a job application and drafts a cover letter from the ad you're reading — after you've read it.",
  "permissions": ["storage", "downloads", "scripting", "activeTab", "webNavigation"],
  "host_permissions": [
    "https://*.seek.com.au/*",
    "https://*.seek.co.nz/*",
    "https://*.seek.com/*",
    "https://*.indeed.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.myworkdaysite.com/*",
    "https://*.smartrecruiters.com/*",
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://*.ashbyhq.com/*",
    "https://*.workable.com/*",
    "https://*.teamtailor.com/*",
    "https://*.recruitee.com/*",
    "https://*.jobvite.com/*",
    "https://*.icims.com/*",
    "https://*.taleo.net/*",
    "https://*.successfactors.com/*",
    "https://*.successfactors.eu/*",
    "https://*.oraclecloud.com/*",
    "https://*.bamboohr.com/*",
    "https://*.applytojob.com/*",
    "https://*.personio.com/*",
    "https://*.personio.de/*",
    "https://workforcenow.adp.com/*",
    "https://recruiting.ultipro.com/*",
    "https://jobs.dayforcehcm.com/*",
    "https://ats.rippling.com/*",
    "https://*.breezy.hr/*",
    "https://*.pinpointhq.com/*",
    "https://jobs.comeet.com/*",
    "https://*.applicantpro.com/*",
    "https://recruiting.paylocity.com/*",
    "https://jobs.zohorecruit.com/*",
    "http://127.0.0.1:8787/*"
  ],
  "background": { "service_worker": "background.js" },
  "options_page": "options/options.html",
  "action": {
    "default_title": "Cover Letter Copilot — click to open it on this page"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.seek.com.au/*",
        "https://*.seek.co.nz/*",
        "https://*.seek.com/*",
        "https://*.indeed.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkdaysite.com/*",
        "https://*.smartrecruiters.com/*",
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.ashbyhq.com/*",
        "https://*.workable.com/*",
        "https://*.teamtailor.com/*",
        "https://*.recruitee.com/*",
        "https://*.jobvite.com/*",
        "https://*.icims.com/*",
        "https://*.taleo.net/*",
        "https://*.successfactors.com/*",
        "https://*.successfactors.eu/*",
        "https://*.oraclecloud.com/*",
        "https://*.bamboohr.com/*",
        "https://*.applytojob.com/*",
        "https://*.personio.com/*",
        "https://*.personio.de/*",
        "https://workforcenow.adp.com/*",
        "https://recruiting.ultipro.com/*",
        "https://jobs.dayforcehcm.com/*",
        "https://ats.rippling.com/*",
        "https://*.breezy.hr/*",
        "https://*.pinpointhq.com/*",
        "https://jobs.comeet.com/*",
        "https://*.applicantpro.com/*",
        "https://recruiting.paylocity.com/*",
        "https://jobs.zohorecruit.com/*"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "js": [
        "content/dom.js",
        "content/adapters.js",
        "content/autofill.js",
        "content/panel.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
