# Copy this file to .env and fill in one key. .env is read at startup and
# never leaves this machine — with no APP_TOKEN set the server binds to
# 127.0.0.1, so only this computer can reach it and the key stays here.

# Which provider to draft with: anthropic (default) or openai
PROVIDER=anthropic

# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Only needed if PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Optional overrides
# MODEL=claude-opus-5
# EFFORT=medium          # low | medium | high | xhigh | max
# PORT=8787

# --- Hosting it (Railway, a VPS, anything with a public URL) ----------------
# Setting APP_TOKEN switches the bind to 0.0.0.0 and makes /generate,
# /parse-resume and /docx require "Authorization: Bearer <token>". Paste the
# same string into the extension's settings. Leave it unset for local use;
# the server refuses to listen off loopback without it, because an open
# /generate spends your API balance for whoever finds the URL.
#
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# APP_TOKEN=

# Override the bind address if you need something other than the default
# (127.0.0.1 without a token, 0.0.0.0 with one).
# HOST=0.0.0.0
