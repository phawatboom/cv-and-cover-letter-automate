# Copy this file to .env and fill in one key. .env is read at startup and
# never leaves this machine — the browser extension only ever talks to
# 127.0.0.1, and the key stays in this process.

# Which provider to draft with: anthropic (default) or openai
PROVIDER=anthropic

# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Only needed if PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Optional overrides
# MODEL=claude-opus-5
# EFFORT=medium          # low | medium | high | xhigh | max
# PORT=8787
